rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'REPLACE_WITH_YOUR_ADMIN_EMAIL';
    }

    match /site/content {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Deny all other documents unless a specific rule is added later.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
